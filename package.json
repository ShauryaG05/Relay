{
  "name": "relay-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Relay - Secure remote control and monitoring for macOS from any browser",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:gateway": "npm run dev --workspace=@relay/gateway",
    "dev:agent": "npm run dev --workspace=@relay/agent",
    "dev:web": "npm run dev --workspace=@relay/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
